PORT=3000
FRONTEND_URL=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=nexus
DB_USER=root
DB_PASSWORD=

# Monitoring engine: checks every registered API on its interval and stores results for reports.
MONITORING_ENABLED=true
# Allow checks against localhost / private networks (needed to monitor APIs running on your machine).
MONITOR_ALLOW_PRIVATE_TARGETS=false
MONITOR_DEGRADED_AFTER_MS=1000
MONITOR_RETENTION_DAYS=90
