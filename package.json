{
  "name": "nexus-platform",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n frontend,backend -c blue,green \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "test": "npm --prefix backend test",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix backend run typecheck && npm --prefix frontend run typecheck",
    "build": "npm --prefix backend run build && npm --prefix frontend run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aryann2611/NEXUS-PLATFORM.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/aryann2611/NEXUS-PLATFORM/issues"
  },
  "homepage": "https://github.com/aryann2611/NEXUS-PLATFORM#readme",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
